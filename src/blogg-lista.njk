      {% for k in collections.kategorier %}<li><a href="/blogg/kategori/{{ k | slug }}/">{{ k }}</a></li>{% endfor %}
    </ul>
  </div>
</section>
<section class="sektion">
  <div class="wrap kortrutnat">
    {% for p in collections.inlagg %}{% include "kort.njk" %}{% endfor %}
  </div>
</section>
